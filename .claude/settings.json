{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.preview)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.preview)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy:*)",
      "Bash(npm run seed:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push*main*)",
      "PowerShell(git push*main*)",
      "Bash(git push*--force*)",
      "PowerShell(git push*--force*)",
      "Bash(git push* -f*)",
      "PowerShell(git push* -f*)",
      "Bash(git push*+*)",
      "PowerShell(git push*+*)",
      "Bash(git push*--delete*)",
      "PowerShell(git push*--delete*)",
      "Bash(git push*--all*)",
      "PowerShell(git push*--all*)",
      "Bash(git push*--mirror*)",
      "PowerShell(git push*--mirror*)",
      "Bash(gh api*-X*)",
      "PowerShell(gh api*-X*)",
      "Bash(gh api*--method*)",
      "PowerShell(gh api*--method*)",
      "Bash(gh api* -f *)",
      "PowerShell(gh api* -f *)",
      "Bash(gh api* -F *)",
      "PowerShell(gh api* -F *)",
      "Bash(gh api*--field*)",
      "PowerShell(gh api*--field*)",
      "Bash(gh api*--raw-field*)",
      "PowerShell(gh api*--raw-field*)",
      "Bash(gh api*--input*)",
      "PowerShell(gh api*--input*)",
      "Bash(gh api*graphql*)",
      "PowerShell(gh api*graphql*)",
      "Bash(gh pr merge*--admin*)",
      "PowerShell(gh pr merge*--admin*)",
      "Bash(vercel*deploy*)",
      "PowerShell(vercel*deploy*)",
      "Bash(vercel*--prod*)",
      "PowerShell(vercel*--prod*)",
      "Bash(vercel promote*)",
      "PowerShell(vercel promote*)",
      "Bash(vercel rollback*)",
      "PowerShell(vercel rollback*)",
      "Bash(vercel env pull*)",
      "PowerShell(vercel env pull*)",
      "Bash(npx vercel*)",
      "PowerShell(npx vercel*)",
      "Bash(npm*seed*)",
      "PowerShell(npm*seed*)",
      "Bash(node*seed*)",
      "PowerShell(node*seed*)",
      "PowerShell(Remove-Item*-Recurse*)"
    ],
    "allow": [
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh pr list*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "PowerShell(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.sh\""
          }
        ]
      }
    ]
  }
}
