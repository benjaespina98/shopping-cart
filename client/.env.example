# Variables de entorno del cliente (Vite).
# Copiar como client/.env.local y completar. *.local esta en .gitignore.
#
# IMPORTANTE: toda variable VITE_* se incrusta en el bundle JavaScript en el
# build y la ve cualquier visitante. NUNCA pongas secretos aca; marcarlas como
# Sensitive en Vercel no las protege. Cambiarlas requiere un nuevo build.
# Los valores son placeholders (CHANGE_ME). Matriz por entorno: docs/ENV.md

# URL base de la API. SOLO la usa el dev server (npm run dev); en builds de
# produccion el cliente usa siempre /api del mismo origen (src/services/api.js).
# Si falta, usa /api con el proxy de Vite. Entornos: Local.
VITE_API_URL=/api

# Destino del proxy de /api del dev server de Vite (vite.config.js). No es
# VITE_*: se lee del entorno del proceso. Por defecto http://localhost:5000.
# Entornos: Local.
# VITE_API_PROXY_TARGET=http://localhost:5000

# ID de medicion de Google Analytics 4 (G-XXXXXXXXXX). Publico por diseno. Sin
# el, no se carga ningun script de analytics. Entornos: Production (en Preview y
# Local, vacio para no ensuciar las metricas).
VITE_GA_MEASUREMENT_ID=CHANGE_ME_G-XXXXXXXXXX

# Numero de WhatsApp por defecto del sitio, solo digitos con codigo de pais.
# Sirve de valor inicial hasta que carga la configuracion del servidor. Dato
# publico. Opcional. Entornos: todos.
VITE_WHATSAPP_NUMBER=CHANGE_ME_5493510000000
