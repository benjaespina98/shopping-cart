# Variables de entorno del servidor.
# Copiar como server/.env y completar. NUNCA commitear el .env real.
# Todos los valores de este archivo son placeholders (CHANGE_ME): ninguno es real.
# Matriz por entorno y politica de rotacion: docs/ENV.md
#
# Convenciones de los comentarios:
#   [SECRETO]  -> marcar como Sensitive en Vercel y no loguear.
#   [REQUERIDA]-> la app (o el flujo indicado) falla sin ella.
#   Entornos   -> Production / Preview / Local (desarrollo en tu maquina).

# ---------------------------------------------------------------------------
# Entorno de ejecucion
# ---------------------------------------------------------------------------

# Modo de Node. Vercel lo fija solo (production en Production y Preview): no la
# definas alli. Local: development. Con NODE_ENV=production el server NO acepta
# origenes localhost por CORS (server/app.js).
# Entornos: Local.
NODE_ENV=development

# Etiqueta de entorno de la app: production | preview | testing | development.
# Local la usa para elegir que base de datos usar (server/config/env.js). En
# Vercel NO hace falta: VERCEL_ENV (que pone Vercel) tiene prioridad.
# Entornos: Local.
APP_ENV=development

# Puerto del server local. Por defecto 5000 (el proxy de Vite apunta ahi).
# Entornos: Local.
PORT=5000

# ---------------------------------------------------------------------------
# Base de datos (MongoDB Atlas)  [SECRETO: contienen usuario y contrasena]
# Un usuario y una base DISTINTOS por entorno. Nunca compartir entre entornos.
# ---------------------------------------------------------------------------

# Base de desarrollo local. Entornos: Local.
MONGODB_URI_DEVELOPMENT=CHANGE_ME_mongodb+srv://USER:PASSWORD@HOST/DB_DEV
# Base de Preview/testing. [REQUERIDA] en Preview: sin ella el server se niega a
# conectar para no tocar produccion. Entornos: Preview (y Local si probas preview).
MONGODB_URI_PREVIEW=CHANGE_ME_mongodb+srv://USER:PASSWORD@HOST/DB_PREVIEW
# Base de produccion. [REQUERIDA] en Production. Entornos: SOLO Production.
MONGODB_URI_PRODUCTION=CHANGE_ME_mongodb+srv://USER:PASSWORD@HOST/DB_PROD

# Fallback legacy (opcional, NO recomendado): si falta MONGODB_URI_PRODUCTION,
# Production usa esta; en Local sustituye a MONGODB_URI_DEVELOPMENT. No la
# definas en Vercel: podria hacer que un entorno use la base equivocada.
# MONGODB_URI=CHANGE_ME_mongodb+srv://USER:PASSWORD@HOST/DB
# Alias legacy de MONGODB_URI_PREVIEW (tests/preview). Preferir MONGODB_URI_PREVIEW.
# MONGODB_URI_TEST=CHANGE_ME_mongodb+srv://USER:PASSWORD@HOST/DB_TEST

# ---------------------------------------------------------------------------
# Autenticacion (JWT)
# ---------------------------------------------------------------------------

# [SECRETO] [REQUERIDA en Production y Preview] Clave que firma los tokens del
# admin. Aleatoria, larga (>= 32 bytes) y DISTINTA por entorno. Rotarla cierra
# todas las sesiones. Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_random_secret_min_32_bytes
# Vigencia del token (formato de jsonwebtoken: 1h, 7d...). Opcional, por
# defecto 7d. Entornos: todos.
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Cloudinary (imagenes)
# Todos los entornos suben a la misma carpeta shopping-cart/* del cloud
# configurado: usar un cloud o credenciales DISTINTAS para Preview.
# ---------------------------------------------------------------------------

# [REQUERIDA en Production y Preview] Nombre del cloud. No es secreto (aparece
# en las URLs publicas de las imagenes).
CLOUDINARY_CLOUD_NAME=CHANGE_ME_cloud_name
# [REQUERIDA en Production y Preview] Identificador de la API key. Semi-publico.
CLOUDINARY_API_KEY=CHANGE_ME_api_key
# [SECRETO] [REQUERIDA en Production y Preview] Permite subir y BORRAR imagenes.
CLOUDINARY_API_SECRET=CHANGE_ME_api_secret

# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------

# Origenes permitidos por CORS, separados por coma; admite comodin (*). No es
# secreto. Production: https://TU-DOMINIO. Preview: patron de los previews de
# Vercel. Local: si falta, usa http://localhost:5173 y 127.0.0.1:5173.
CLIENT_URL=http://localhost:5173
# Nombre del local: lo usan el mensaje de WhatsApp y el remitente del email.
# Opcional (por defecto "Playa y Sol Piscinas"). No es secreto.
STORE_NAME=CHANGE_ME_Nombre_del_local
# [REQUERIDA para crear pedidos] Numero del local con codigo de pais, solo
# digitos, sin + ni espacios. Sin el, POST /api/orders responde 500. Dato
# publico, no es secreto. Entornos: todos.
WHATSAPP_NUMBER=CHANGE_ME_5493510000000

# ---------------------------------------------------------------------------
# Email de notificaciones (SMTP). Opcional: si falta algo, la consulta se guarda
# igual y solo se omite el email (server/utils/mailer.js).
# Recomendado: definirlas SOLO en Production, para que los previews y los tests
# locales no envien mails reales.
# ---------------------------------------------------------------------------

# Servidor SMTP. Entornos: Production.
SMTP_HOST=CHANGE_ME_smtp.example.com
# Puerto. 465 (TLS directo, por defecto) o 587 (STARTTLS).
SMTP_PORT=465
# Usuario SMTP; tambien es el remitente (From).
SMTP_USER=CHANGE_ME_smtp_user
# [SECRETO] Contrasena (o app password) del SMTP.
SMTP_PASS=CHANGE_ME_smtp_password
# Casilla que recibe las notificaciones de presupuestos y consultas.
QUOTE_NOTIFY_EMAIL=CHANGE_ME_destino@example.com

# ---------------------------------------------------------------------------
# Seed (SOLO local, `npm run seed`). NO definir en Vercel.
# El seed nunca se corre contra produccion (ver CLAUDE.md).
# ---------------------------------------------------------------------------

# Email del admin que crea el seed. Si el admin ya existe no se modifica nada.
ADMIN_EMAIL=CHANGE_ME_admin@example.com
# [SECRETO] Contrasena inicial del admin: obligatoria para el seed, minimo 12
# caracteres, sin valor por defecto. El server en ejecucion NO la lee.
ADMIN_PASSWORD=CHANGE_ME_min_12_chars
# Fuerza el entorno del seed: production | preview | testing | development.
# Opcional. Cuidado: puede apuntar el seed a otra base.
# SEED_ENV=development
